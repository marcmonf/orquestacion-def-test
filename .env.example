# Plantilla de variables de entorno. Copiar a .env (NUNCA se versiona) y rellenar.
# Este repo es PÚBLICO: aquí solo van nombres y valores de ejemplo, jamás secretos
# reales. En Render se configuran en el panel del servicio → Environment.

# ── Obligatorias ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
PAYNOPAIN_API_KEY=<api key de Paylands>
PAYNOPAIN_SIGNATURE=<signature del servicio Paylands>
PAYNOPAIN_SERVICE_UUID=<uuid del servicio Paylands>
PAYNOPAIN_ENV=sandbox
SERVER_URL=https://<tu-servicio>.onrender.com

# Secretos de la plataforma (cadenas largas y aleatorias, TODAS distintas).
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=<64 hex>
BACKOFFICE_JWT_SECRET=<64 hex>
PORTAL_JWT_SECRET=<64 hex, distinto del anterior>
HPP_SIGNING_SECRET=<64 hex>

# ── Opcionales ───────────────────────────────────────────────────────────────
# Solo para desarrollo local (en producción NO): usa secretos de desarrollo y
# registra el conector simulado dummyCard.
# NODE_ENV=development
# WEBHOOK_SECRET=<secreto global de fallback para firmar webhooks>
# SUPPORTED_CURRENCIES=EUR
# MAX_PAYMENT_AMOUNT=100000000
# API_KEY_SIMPLE_FALLBACK=true
# ALLOWED_ORIGINS=https://tu-dominio.com
# DOCS_ENABLED=true
