    {
      "name": "15. Redsys directo (v2.17.0)",
      "description": "Runbook: docs/redsys.md. Usa las variables adminToken y merchantId de la carpeta 14.",
      "item": [
        {
          "name": "15.1 /admin: guardar TPV de Redsys de pruebas",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/backoffice/merchants/{{merchantId}}/connector-accounts/redsys/credentials",
              "host": [
                "{{host}}"
              ],
              "path": [
                "backoffice",
                "merchants",
                "{{merchantId}}",
                "connector-accounts",
                "redsys",
                "credentials"
              ]
            },
            "description": "Pega el FUC, el terminal y la clave del comercio de pruebas del manual de Redsys (o los de tu banco). Esperado 200 con la clave enmascarada. 400 si el FUC no tiene 9 cifras o la clave no es válida. 404 unknown_connector si falta FEATURE_REDSYS=true + deploy.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"test\",\n  \"credentials\": {\n    \"merchantCode\": \"FUC_9_CIFRAS\",\n    \"terminal\": \"TERMINAL\",\n    \"secretKey\": \"CLAVE_SHA256_BASE64\"\n  }\n}"
            }
          }
        },
        {
          "name": "15.2 /admin: routing EUR+ES → Redsys, resto → Paylands",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/backoffice/routing/{{merchantId}}/demo-preset",
              "host": [
                "{{host}}"
              ],
              "path": [
                "backoffice",
                "routing",
                "{{merchantId}}",
                "demo-preset"
              ]
            },
            "description": "Esperado 200.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domesticConnector\": \"redsys\",\n  \"restConnector\": \"payNoPain\"\n}"
            }
          }
        },
        {
          "name": "15.3 Crear sesión que va a Redsys (EUR, ES)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{host}}/v1/checkout-sessions",
              "host": [
                "{{host}}"
              ],
              "path": [
                "v1",
                "checkout-sessions"
              ]
            },
            "description": "Esperado 201. Abre la url: botón \"Pagar ahora\" que lleva a la página de Redsys.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1250,\n  \"currency\": \"EUR\",\n  \"country\": \"ES\",\n  \"reference\": \"PRUEBA-REDSYS-1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b && b.id) { pm.collectionVariables.set('paymentId', b.id); console.log('Abre para pagar:', b.url); }"
                ]
              }
            }
          ]
        },
        {
          "name": "15.4 Consultar el pago (tras pagar en Redsys)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/v1/payments/{{paymentId}}",
              "host": [
                "{{host}}"
              ],
              "path": [
                "v1",
                "payments",
                "{{paymentId}}"
              ]
            },
            "description": "Esperado status \"authorized\" cuando llega la notificación de Redsys (o \"pending_3ds\" si aún no ha llegado)."
          }
        },
        {
          "name": "15.5 Capturar (APAGADO con Redsys)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{host}}/v1/payments/{{paymentId}}/capture",
              "host": [
                "{{host}}"
              ],
              "path": [
                "v1",
                "payments",
                "{{paymentId}}",
                "capture"
              ]
            },
            "description": "Esperado HOY: 502 con detail \"not_supported\" (se confirma desde el panel de Redsys). No es un bug: canal de operaciones sin verificar.",
            "body": {
