{
  "info": {
    "name": "Monetiser Base",
    "_postman_id": "a1111111-b222-4333-8444-555555555555",
    "description": "Initialize + iFrame + Orchestration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Initialize",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{host}}/initialize", "host": ["{{host}}"], "path": ["initialize"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantId\": \"demo-merchant\",\n  \"amount\": 25,\n  \"currency\": \"EUR\",\n  \"method\": \"card\",\n  \"returnUrl\": \"https://miweb.com/return\",\n  \"callbackUrl\": \"https://miweb.com/callback\"\n}"
        }
      }
    },
    {
      "name": "Orchestration Decide",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": \"{{host}}/orchestration/decide\", "host": ["{{host}}"], "path": ["orchestration","decide"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantId\": \"demo-merchant\",\n  \"amount\": 25,\n  \"currency\": \"EUR\",\n  \"method\": \"card\",\n  \"cardNumber\": \"4111111111111111\"\n}"
        }
      }
    },
    {
      "name": "iFrame (GET)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{host}}/iframe?merchantId={{merchantId}}&paymentId={{paymentId}}&amount=25&currency=EUR&nonce={{nonce}}&exp={{exp}}&signature={{signature}}",
          "host": ["{{host}}"],
          "path": ["iframe"],
          "query": [
            { "key": "merchantId", "value": "{{merchantId}}" },
            { "key": "paymentId", "value": "{{paymentId}}" },
            { "key": "amount", "value": "25" },
            { "key": "currency", "value": "EUR" },
            { "key": "nonce", "value": "{{nonce}}" },
            { "key": "exp", "value": "{{exp}}" },
            { "key": "signature", "value": "{{signature}}" }
          ]
        }
      }
    }
  ],
  "variable": [
    { "key": "host", "value": "http://localhost:3000" },
    { "key": "merchantId", "value": "demo-merchant" },
    { "key": "paymentId", "value": "" },
    { "key": "nonce", "value": "" },
    { "key": "exp", "value": "" },
    { "key": "signature", "value": "" }
  ]
}
