// src/middleware/checkRole.js
const getMessage = require('../i18n/getMessage');

const rolePermissions = {
  '/tokens': ['admin'],
  '/transactions': ['admin', 'merchant'],
  '/analytics': ['admin', 'analyst']
};

module.exports = (allowedRoles) => {
  return (req, res, next) => {
    const lang = req.headers['accept-language']?.split(',')[0]?.split('-')[0]?.trim().toLowerCase() || 'en';

    // Se prioriza el rol inyectado por el backend, si existe
    const role = req.userRole || req.headers['x-user-role'];

    if (!allowedRoles.includes(role)) {
      return res.status(403).json({
        success: false,
        message: getMessage(lang, 'error.insufficientPermissions')
      });
    }

    next();
  };
};
